# URL canonique du site (sans slash final)
NEXT_PUBLIC_SITE_URL="https://notaire-letreut-combrit.fr"

# Affiche des biens immobiliers de DÉMONSTRATION, clairement étiquetés « exemple ».
# Doit rester absent ou "false" en production.
NEXT_PUBLIC_DEMO_LISTINGS="false"

# Destination des demandes envoyées depuis le formulaire de contact.
# Sans configuration, le formulaire n'envoie rien et invite l'internaute
# à écrire directement à l'étude (aucun message n'est perdu silencieusement).
CONTACT_WEBHOOK_URL=""
CONTACT_TO_EMAIL="marine.letreut@notaires.fr"
